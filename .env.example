# --- MongoDB Atlas connection ---
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.hd93qzs.mongodb.net/
DB_NAME=pharmacy_inventory

# --- Server ---
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=8h

# Items expiring within this many days are flagged "near expiry"
NEAR_EXPIRY_DAYS=90

# Name shown on login, header and printed reports
HOSPITAL_NAME=General Hospital
